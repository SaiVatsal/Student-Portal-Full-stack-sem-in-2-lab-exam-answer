# Nitro Azard University ERP Environment Variables

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Server-Only Secret (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Auth & Session Security
SESSION_SECRET=a_long_random_entropy_secret_minimum_32_characters_here
AUTH_COOKIE_NAME=nitro_auth_token

# Razorpay Test Mode Gateway (For fee collection)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_here

# App Operational Mode
# When SUPABASE_URL is not configured with a live instance, the app seamlessly runs in standalone seed mode for development & local reviews
STANDALONE_DEV_MODE=true
